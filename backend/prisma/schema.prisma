// VoteSecure Database Schema
// Privacy-preserving voting model with separated identity and ballot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  voter
  election_officer
  admin
  super_admin
}

enum ElectionStatus {
  draft
  scheduled
  open
  closed
  counting
  results_published
  archived
}

enum ElectionType {
  presidential
  parliamentary
  student
  organizational
  custom
}

enum CandidateStatus {
  pending
  approved
  rejected
  withdrawn
}

enum NotificationType {
  info
  warning
  success
  error
}

enum SecuritySeverity {
  low
  medium
  high
  critical
}

// ==================== TABLES ====================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            UserRole  @default(voter)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  profile         VoterProfile?
  sessions        Session[]
  createdElections Election[]
  auditLogs       AuditLog[]
  securityEvents  SecurityEvent[] @relation("SecurityEventActor")
  notifications   Notification[]

  @@map("users")
}

model VoterProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  studentId   String   @unique @map("student_id")
  fullName    String   @map("full_name")
  department  String
  yearOfStudy Int?     @map("year_of_study")
  phone       String?
  isVerified  Boolean  @default(false) @map("is_verified")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  votingEligibility ElectionVoterEligibility[]

  @@map("voter_profiles")
}

model Election {
  id            String         @id @default(uuid())
  title         String
  description   String?
  type          ElectionType
  status        ElectionStatus @default(draft)
  startTime     DateTime       @map("start_time")
  endTime       DateTime       @map("end_time")
  createdBy     String         @map("created_by")
  settings      Json           @default("{}")
  integrityHash String?        @map("integrity_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  creator       User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  positions     ElectionPosition[]
  candidates    Candidate[]
  voterEligibility ElectionVoterEligibility[]
  ballots       Ballot[]
  results       ResultsCache[]

  @@index([status])
  @@index([createdBy])
  @@index([startTime])
  @@map("elections")
}

model ElectionPosition {
  id             String   @id @default(uuid())
  electionId     String   @map("election_id")
  title          String
  description    String?
  displayOrder   Int      @map("display_order")
  maxSelections  Int      @default(1) @map("max_selections")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  election       Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates     Candidate[]
  ballotChoices  BallotChoice[]
  results        ResultsCache[]

  @@index([electionId])
  @@map("election_positions")
}

model Candidate {
  id           String          @id @default(uuid())
  electionId   String          @map("election_id")
  positionId   String          @map("position_id")
  name         String
  photoUrl     String?         @map("photo_url")
  manifesto    String?
  party        String?
  status       CandidateStatus @default(pending)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relations
  election     Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position     ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  ballotChoices BallotChoice[]
  results      ResultsCache[]

  @@index([electionId])
  @@index([positionId])
  @@map("candidates")
}

model ElectionVoterEligibility {
  id             String    @id @default(uuid())
  electionId     String    @map("election_id")
  voterId        String    @map("voter_id")
  isEligible     Boolean   @default(true) @map("is_eligible")
  hasVoted       Boolean   @default(false) @map("has_voted")
  votedAt        DateTime? @map("voted_at")
  voteTokenHash  String?   @map("vote_token_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  election       Election      @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter          VoterProfile  @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([electionId, voterId])
  @@index([electionId])
  @@index([voterId])
  @@map("election_voter_eligibility")
}

// Privacy-preserving ballot table - NO voter_id!
model Ballot {
  id           String   @id @default(uuid())
  electionId   String   @map("election_id")
  ballotHash   String   @map("ballot_hash")
  submittedAt  DateTime @default(now()) @map("submitted_at")

  // Relations
  election     Election       @relation(fields: [electionId], references: [id], onDelete: Restrict)
  choices      BallotChoice[]

  @@index([electionId])
  @@map("ballots")
}

model BallotChoice {
  id           String   @id @default(uuid())
  ballotId     String   @map("ballot_id")
  positionId   String   @map("position_id")
  candidateId  String?  @map("candidate_id") // Nullable for NOTA
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  ballot       Ballot           @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  position     ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  candidate    Candidate?       @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([ballotId])
  @@index([positionId])
  @@map("ballot_choices")
}

model ResultsCache {
  id             String   @id @default(uuid())
  electionId     String   @map("election_id")
  positionId     String   @map("position_id")
  candidateId    String?  @map("candidate_id") // Nullable for NOTA
  voteCount      Int      @default(0) @map("vote_count")
  percentage     Decimal  @default(0) @db.Decimal(5, 2)
  lastCalculated DateTime @default(now()) @map("last_calculated")

  // Relations
  election       Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position       ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate      Candidate?      @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([electionId, positionId, candidateId])
  @@index([electionId])
  @@map("results_cache")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String?  @map("actor_id")
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  actor        User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id         String           @id @default(uuid())
  eventType  String           @map("event_type")
  severity   SecuritySeverity
  details    Json?
  ipAddress  String?          @map("ip_address")
  userAgent  String?          @map("user_agent")
  resolvedAt DateTime?        @map("resolved_at")
  resolvedBy String?          @map("resolved_by")
  createdAt  DateTime         @default(now()) @map("created_at")

  // Relations
  resolver   User?   @relation("SecurityEventActor", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType @default(info)
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
