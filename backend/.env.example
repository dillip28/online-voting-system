# VoteSecure Backend Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/votesecure?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="1h"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880  # 5MB
